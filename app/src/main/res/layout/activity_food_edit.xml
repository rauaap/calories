<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/food_back"
            style="@style/IconButton"
            android:contentDescription="Back"
            android:src="@drawable/ic_chevron_left" />

        <TextView
            android:id="@+id/food_title"
            style="@style/Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/food_delete"
            style="@style/FlatButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delete"
            android:visibility="gone" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/food_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Open Food Facts has no per-100 data for this product. Fill in the nutrients from the label."
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                style="@style/Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Name" />

            <EditText
                android:id="@+id/food_name"
                style="@style/Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences" />

            <TextView
                style="@style/Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                android:text="Brand" />

            <EditText
                android:id="@+id/food_brand"
                style="@style/Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords" />

            <TextView
                style="@style/Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                android:text="Barcode" />

            <EditText
                android:id="@+id/food_barcode"
                style="@style/Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />

            <TextView
                style="@style/Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="4dp"
                android:text="Nutrition per" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/food_per"
                    style="@style/Field"
                    android:layout_width="96dp"
                    android:layout_height="wrap_content"
                    android:gravity="end|center_vertical"
                    android:imeOptions="actionNext|flagNoExtractUi" />

                <Spinner
                    android:id="@+id/food_unit"
                    android:layout_width="120dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Calories"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/food_kcal"
                    style="@style/Field"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:gravity="end|center_vertical"
                    android:hint="0"
                    android:imeOptions="actionNext|flagNoExtractUi" />

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:text="kcal"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Fat"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/food_fat"
                    style="@style/Field"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:gravity="end|center_vertical"
                    android:hint="0"
                    android:imeOptions="actionNext|flagNoExtractUi" />

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:text="g"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Carbs"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/food_carbs"
                    style="@style/Field"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:gravity="end|center_vertical"
                    android:hint="0"
                    android:imeOptions="actionNext|flagNoExtractUi" />

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:text="g"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Protein"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/food_protein"
                    style="@style/Field"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:gravity="end|center_vertical"
                    android:hint="0"
                    android:imeOptions="actionNext|flagNoExtractUi" />

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:text="g"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <TextView
                style="@style/Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="4dp"
                android:text="Serving (optional)" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/food_serving"
                    style="@style/Field"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:gravity="end|center_vertical" />

                <TextView
                    android:id="@+id/food_serving_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Only prefills the amount when you add this food. The nutrients above are always per the reference amount."
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/food_save"
        style="@style/AccentButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="Save" />
</LinearLayout>
